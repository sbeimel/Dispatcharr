diff --git a/apps/proxy/live_proxy/server.py b/apps/proxy/live_proxy/server.py
index existing..new 100644
--- a/apps/proxy/live_proxy/server.py
+++ b/apps/proxy/live_proxy/server.py
@@ -2393,10 +2393,25 @@
                     for pattern in patterns:
                         cursor = 0
                         while True:
                             cursor, keys = self.redis_client.scan(cursor, match=pattern, count=100)
                             if keys:
-                                self.redis_client.delete(*keys)
-                                total_deleted += len(keys)
+                                # Filter out cooldown keys - they should persist beyond channel lifetime
+                                keys_to_delete = []
+                                cooldown_keys = []
+                                
+                                for k in keys:
+                                    # Handle both bytes and str keys
+                                    key_str = k.decode('utf-8') if isinstance(k, bytes) else k
+                                    
+                                    if key_str.endswith(':cooldown'):
+                                        cooldown_keys.append(k)
+                                    else:
+                                        keys_to_delete.append(k)
+                                
+                                if keys_to_delete:
+                                    self.redis_client.delete(*keys_to_delete)
+                                    total_deleted += len(keys_to_delete)
+                                
+                                # Log skipped cooldown keys
+                                if cooldown_keys:
+                                    logger.debug(f"Preserved {len(cooldown_keys)} cooldown keys for channel {channel_id}")
 
                             if cursor == 0:
                                 break

